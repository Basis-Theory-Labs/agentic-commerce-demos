# --- Basis Theory Agentic Commerce credentials ---

# Private API key (server-side only) — used by API routes to call BT.
BT_API_KEY=key_priv_...

# Public API key (client-side) — used by Elements + react-agentic SDKs.
NEXT_PUBLIC_BT_API_KEY=key_pub_...

# Environment: production | test | local
#  - test       → https://api.test.basistheory.com
#  - production → https://api.basistheory.com
#  - local      → http://localhost:3001 (override with BT_LOCAL_API_URL)
BT_ENVIRONMENT=test
NEXT_PUBLIC_BT_ENVIRONMENT=test

# Only used when BT_ENVIRONMENT=local. Point both at a BT-compatible API
# running on your own machine. The SDK appends `/agentic` automatically.
# BT_LOCAL_API_URL=http://localhost:3001
# NEXT_PUBLIC_BT_LOCAL_API_URL=http://localhost:3001
