# --- Basis Theory Agentic Commerce credentials ---

# Private API key — used by the Next.js API routes (server-side only).
BT_API_KEY=key_priv_...

# Public API key — used by Elements + react-agentic (client-side).
NEXT_PUBLIC_BT_API_KEY=key_pub_...

# Environment: test | production
#  test       → https://api.test.basistheory.com
#  production → https://api.basistheory.com
BT_ENVIRONMENT=test
NEXT_PUBLIC_BT_ENVIRONMENT=test
