# --- Basis Theory Agentic Commerce credentials ---

# Private API key (server-side only) — used by API routes to call BT
BT_API_KEY=key_priv_...

# Public API key (client-side) — used by Elements + react-agentic SDKs
NEXT_PUBLIC_BT_API_KEY=key_pub_...

# Environment: production | test
# All API calls (server + SDK) target this environment.
BT_ENVIRONMENT=test
NEXT_PUBLIC_BT_ENVIRONMENT=test
