# ── Keys ────────────────────────────────────────────────────────────────────
# Private application key. Server-side ONLY — used by the Next.js proxy for
# allowance create/read/patch/cancel/rails retry, credential mint/list/get,
# payment-method reads/deletes, and /errors. Exact required permissions:
# agentic:payment-method:get, agentic:payment-method:delete,
# agentic:allowance:create, agentic:allowance:get, agentic:allowance:update,
# agentic:allowance:delete, agentic:credential:create, agentic:credential:get.
# Never expose it through NEXT_PUBLIC_*.
BT_API_KEY=

# Public application key. Safe in the browser by design — used for card
# tokenization, payment-method creation/rail retry, and allowance verification.
# Required permissions: token:create, agentic:payment-method:create,
# agentic:allowance:verify.
NEXT_PUBLIC_BT_API_KEY=

# ── API base URLs ───────────────────────────────────────────────────────────
# The Agentic API, twice: BT_AGENTIC_API_URL is what the server proxy calls,
# NEXT_PUBLIC_BT_AGENTIC_API_URL is what the browser calls directly.
# Deployed test environment (default):
BT_AGENTIC_API_URL=https://api.test.basistheory.com/agentic
NEXT_PUBLIC_BT_AGENTIC_API_URL=https://api.test.basistheory.com/agentic
# Locally-run agentic-commerce mounts its routes under /api. Start that
# service with PORT=3001 because this Next app already uses port 3000:
# BT_AGENTIC_API_URL=http://localhost:3001/api
# NEXT_PUBLIC_BT_AGENTIC_API_URL=http://localhost:3001/api

# Basis Theory vault base URL — browser-side card tokenization (Elements and
# the raw mock-PAN path both post here with the public key).
NEXT_PUBLIC_BT_VAULT_API_URL=https://api.test.basistheory.com

# ── Tenant & identity ───────────────────────────────────────────────────────
# Only exact 'test' enables mock-card defaults and mock-only shortcuts.
# 'production', a missing value, or a typo fails closed to real-card behavior.
BT_TENANT_TYPE=test

# Shown to cardholders by the card networks during verification ("Add
# Allowance to <name>"). 1–60 characters.
BT_DISPLAY_NAME=Example Agent

# ── Verification UI ─────────────────────────────────────────────────────────
# The SDK is the default product path. Set true only when you also want the
# Manual (raw API) teaching/debug option in the verification mode control.
NEXT_PUBLIC_ENABLE_MANUAL_VERIFICATION=false

# ── Visa ceremony environment ───────────────────────────────────────────────
# 'production' (default) always uses the embed block served by the API — the
# right choice for test tenants and production alike. In the Manual variant,
# 'sandbox' overrides Visa with the credentials below (production tenants
# testing against Visa's sandbox only). The current SDK exposes no matching
# override. No network credentials live in source.
NEXT_PUBLIC_BT_VISA_ENVIRONMENT=production
# NEXT_PUBLIC_BT_VISA_SANDBOX_IFRAME_URL=
# NEXT_PUBLIC_BT_VISA_SANDBOX_API_KEY=
# NEXT_PUBLIC_BT_VISA_SANDBOX_CLIENT_APP_ID=
